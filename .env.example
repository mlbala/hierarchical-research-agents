# Research Hive configuration (placeholders only; copy to .env and edit).
# .env is git-ignored. Secrets are read only by the backend and are never sent
# to the browser, written to logs, or stored with research runs.

# --- Server -----------------------------------------------------------------
APP_ENV=development
HOST=127.0.0.1
PORT=8000
# Browser origin(s) allowed to call the API (comma-separated, no wildcards).
APP_ORIGIN=http://localhost:5173
# Host headers the server accepts (comma-separated). Add your LAN name/IP only
# for a deliberate private-network deployment (see docs/security.md).
ALLOWED_HOSTS=localhost,127.0.0.1
# true = offline demo with fictional fixtures (no API keys, no external calls).
DEMO_MODE=true

# --- PostgreSQL (Aiven or any PostgreSQL 14+) --------------------------------
PGHOST=your-aiven-host
PGPORT=your-aiven-port
# Use a dedicated database if you can; an existing one works too because all
# tables live in the DB_SCHEMA schema.
PGDATABASE=research_hive
PGUSER=your-database-user
PGPASSWORD=replace-me
# verify-full checks the server certificate and hostname against PGSSLROOTCERT.
PGSSLMODE=verify-full
PGSSLROOTCERT=./certs/aiven-ca.pem
DB_SCHEMA=research_hive
DB_POOL_SIZE=3
DB_MAX_OVERFLOW=2

# --- Providers (live mode only) -------------------------------------------------
ANTHROPIC_API_KEY=
# Required in live mode, e.g. claude-opus-5-5 (or claude-sonnet-5-5 for lower cost).
ANTHROPIC_MODEL=
TAVILY_API_KEY=

# --- Logging -------------------------------------------------------------------
LOG_LEVEL=INFO

# --- Execution limits (standard depth; quick depth uses tighter limits) --------
MAX_CONCURRENT_RUNS=1
MAX_PARALLEL_AGENT_TASKS=2
MAX_QUEUED_RUNS=10
MAX_LLM_CALLS_PER_RUN=20
MAX_SEARCH_CALLS_PER_RUN=12
MAX_FETCH_CALLS_PER_RUN=24
MAX_SOURCES_PER_RUN=20
RUN_TIMEOUT_SECONDS=600

# --- Optional settings (defaults shown) ------------------------------------------
# ANTHROPIC_EFFORT=                 # low|medium|high|xhigh|max; empty = model default
# ANTHROPIC_REFUSAL_FALLBACK=true   # server-side refusal fallback on supported models
# LLM_TIMEOUT_SECONDS=60
# FETCH_TIMEOUT_SECONDS=15
# FETCH_MAX_BYTES=2000000
# SOURCE_MAX_CHARS=30000
# TRANSIENT_RETRIES=2
# MAX_RESEARCH_RETRIES=1
# MAX_WRITING_REVISIONS=1
# RUN_CREATE_RATE_LIMIT_PER_MINUTE=6
# TRUSTED_PROXIES=                  # proxy IPs allowed to set X-Forwarded-For
# DEMO_STEP_DELAY_MS=600
# DB_STATEMENT_TIMEOUT_MS=30000     # 0 disables (needed behind some poolers)
# Cost estimates are shown only when BOTH prices are set (USD per million tokens);
# otherwise cost is reported as "unknown". Take values from your provider's price list.
# LLM_INPUT_USD_PER_MTOK=
# LLM_OUTPUT_USD_PER_MTOK=
